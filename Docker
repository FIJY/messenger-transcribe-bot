# Dockerfile - Многоэтапная сборка для оптимизации размера
# Этап 1: Сборщик зависимостей
FROM python:3.11-slim as builder

# Устанавливаем системные зависимости, необходимые для сборки Python-пакетов
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Создаем виртуальное окружение
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Копируем и устанавливаем зависимости
COPY requirements.txt .
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Этап 2: Основной образ приложения
FROM python:3.11-slim

# Устанавливаем только необходимые для работы приложения зависимости
RUN apt-get update && apt-get install -y \
    ffmpeg \
    tor \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Копируем виртуальное окружение из сборщика
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Создаем непривилегированного пользователя для безопасности
RUN useradd --create-home --shell /bin/bash appuser
USER appuser
WORKDIR /home/appuser/app

# Копируем код приложения и меняем владельца
COPY --chown=appuser:appuser . .

# Устанавливаем переменную окружения PYTHONPATH
ENV PYTHONPATH /home/appuser/app

# Открываем порт 10000 для доступа извне
EXPOSE 10000

# Команда для запуска веб-сервера при старте контейнера
CMD ["python", "main.py"]
